# Archon Configuration
# Copy to .env and fill in your values.
# Archon reads this file automatically on startup.

# ── AI (local Ollama — no API key required) ──────────────────────────────────
# Archon talks to a local Ollama server. Start it with `ollama serve` and pull
# a model with `ollama pull qwen3.5:9b`. Override the defaults if needed:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:9b

# ── n8n workflow integration (optional) ──────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here

# ── Behaviour overrides (all have sensible defaults) ─────────────────────────
# CONTINUE_ON_ERROR=false
# MAX_RETRIES=3
# RETRY_DELAY=2
