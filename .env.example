# Tyranos Configuration
# Copy to .env and fill in your values.
# Tyranos reads this file automatically on startup.

# ── AI (at least one key required for AI features) ───────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Leave OPENROUTER_MODEL blank — Tyranos fetches the best free model at runtime.
# OPENROUTER_MODEL=

# Optional additional providers
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── n8n workflow integration (optional) ──────────────────────────────────────
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here

# ── Behaviour overrides (all have sensible defaults) ─────────────────────────
# CONTINUE_ON_ERROR=false
# MAX_RETRIES=3
# RETRY_DELAY=2
